{
  "name": "@hypermarket/contracts",
  "version": "0.0.1",
  "private": true,
  "description": "Shared API contracts with Zod schemas for type-safe API communication",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@hypermarket/eslint-config": "workspace:*",
    "@hypermarket/tsconfig": "workspace:*",
    "typescript": "^5.4.0"
  }
}
