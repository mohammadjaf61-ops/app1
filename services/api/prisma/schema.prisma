// ============================================
// Hypermarket Platform - Database Schema
// PostgreSQL 16 + Prisma ORM
// ============================================
//
// Naming Conventions:
// - Tables: singular, snake_case (via @@map)
// - Columns: snake_case (via @map)
// - IDs: UUID v4
// - Foreign keys: <entity>_id
// - Timestamps: created_at, updated_at, deleted_at
//
// ============================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

/// User roles in the hypermarket system
enum UserRole {
  ADMIN   // Full system access
  MANAGER // Store management
  PICKER  // In-store order fulfillment
  DRIVER  // Delivery personnel
  CASHIER // Point of sale operations
}

/// Order lifecycle status
enum OrderStatus {
  PENDING            // Awaiting confirmation
  CONFIRMED          // Confirmed, ready for picking
  PICKING            // Being picked by staff
  PICKED             // All items collected
  READY_FOR_DELIVERY // Packaged and waiting
  OUT_FOR_DELIVERY   // With driver
  DELIVERED          // Successfully delivered
  CANCELLED          // Cancelled before delivery
}

/// Payment methods (COD primary for Iraq market)
enum PaymentMethod {
  COD // Cash on Delivery - الدفع عند الاستلام
}

/// Delivery assignment status
enum DeliveryStatus {
  ASSIGNED  // Assigned to driver
  PICKED_UP // Driver picked up from store
  IN_TRANSIT // On the way
  DELIVERED // Successfully delivered
  FAILED    // Delivery failed
  RETURNED  // Returned to store
}

/// Audit log action types
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STATUS_CHANGE
  ASSIGNMENT
}

/// Inventory reservation status
enum ReservationStatus {
  HELD      // Reserved, awaiting confirmation
  COMMITTED // Confirmed, inventory deducted
  RELEASED  // Released back to inventory
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

/// System users including staff and administrators
/// All staff members are managed through this table
model User {
  id         String   @id @default(uuid())
  /// Full name in Arabic - الاسم الكامل
  fullName   String   @map("full_name")
  /// Iraqi phone number (07XXXXXXXXX)
  phone      String   @unique
  /// Hashed password
  password   String
  /// User role determines permissions
  role       UserRole
  /// Soft active flag for disabling accounts
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  pickerAssignments Order[]              @relation("OrderPicker")
  driverAssignments DeliveryAssignment[] @relation("DeliveryDriver")
  auditLogs         AuditLog[]           @relation("AuditActor")

  @@index([phone])
  @@index([role])
  @@index([isActive], map: "idx_user_is_active")
  @@map("user")
}

// ============================================
// PRODUCT CATALOG
// ============================================

/// Product categories with hierarchical support
/// Supports unlimited nesting via parent_id self-reference
model Category {
  id        String   @id @default(uuid())
  /// Category name in Arabic - اسم التصنيف
  nameAr    String   @map("name_ar")
  /// Parent category for hierarchical structure (null = root)
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Self-relation for hierarchy
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  // Products in this category
  products Product[]

  @@index([parentId], map: "idx_category_parent_id")
  @@map("category")
}

/// Products available for sale in the hypermarket
/// Prices stored in IQD (Iraqi Dinar) as integers
model Product {
  id            String   @id @default(uuid())
  /// Stock Keeping Unit - unique product identifier
  sku           String   @unique
  /// Product name in Arabic - اسم المنتج
  nameAr        String   @map("name_ar")
  /// Product description in Arabic - وصف المنتج
  descriptionAr String?  @map("description_ar")
  /// Reference to product category
  categoryId    String   @map("category_id")
  /// Cost price in IQD (procurement cost)
  costPrice     Int      @map("cost_price")
  /// Sale price in IQD (customer-facing)
  salePrice     Int      @map("sale_price")
  /// Active products are visible in catalog
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  /// Soft delete timestamp
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  category       Category               @relation(fields: [categoryId], references: [id])
  inventoryItems InventoryItem[]
  orderItems     OrderItem[]
  reservations   InventoryReservation[]

  @@index([sku])
  @@index([categoryId], map: "idx_product_category_id")
  @@index([isActive], map: "idx_product_is_active")
  @@index([deletedAt], map: "idx_product_deleted_at")
  @@map("product")
}

// ============================================
// INVENTORY MANAGEMENT
// ============================================

/// Physical storage locations within the hypermarket
/// Used for picker navigation: Aisle → Shelf → Bin
model InventoryLocation {
  id        String   @id @default(uuid())
  /// Aisle identifier (e.g., "A1", "B2") - الممر
  aisle     String
  /// Shelf number within aisle - الرف
  shelf     String
  /// Bin/compartment within shelf (optional) - الصندوق
  bin       String?
  createdAt DateTime @default(now()) @map("created_at")

  // Inventory items at this location
  inventoryItems InventoryItem[]

  @@unique([aisle, shelf, bin], map: "uq_location_aisle_shelf_bin")
  @@index([aisle])
  @@map("inventory_location")
}

/// Inventory tracking - links products to physical locations
/// Supports multiple locations per product and expiry tracking
model InventoryItem {
  id         String    @id @default(uuid())
  /// Reference to product
  productId  String    @map("product_id")
  /// Physical location in store
  locationId String    @map("location_id")
  /// Current quantity at this location
  quantity   Int       @default(0)
  /// Expiry date for perishables (null for non-perishables)
  expiryDate DateTime? @map("expiry_date")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  // Relations
  product  Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  location InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId], map: "uq_inventory_product_location")
  @@index([productId, locationId], map: "idx_inventory_product_location")
  @@index([expiryDate], map: "idx_inventory_expiry_date")
  @@index([quantity], map: "idx_inventory_quantity")
  @@map("inventory_item")
}

/// Inventory reservations - holds stock during order creation
/// Prevents overselling through transactional guarantees
model InventoryReservation {
  id        String            @id @default(uuid())
  /// Product being reserved
  productId String            @map("product_id")
  /// Order that holds this reservation
  orderId   String            @map("order_id")
  /// Quantity reserved
  quantity  Int
  /// Reservation status
  status    ReservationStatus @default(HELD)
  /// When reservation expires (auto-release)
  expiresAt DateTime          @map("expires_at")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  // Relations
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId], map: "uq_reservation_order_product")
  @@index([productId], map: "idx_reservation_product")
  @@index([orderId], map: "idx_reservation_order")
  @@index([status], map: "idx_reservation_status")
  @@index([expiresAt], map: "idx_reservation_expires_at")
  @@map("inventory_reservation")
}

// ============================================
// ORDERS
// ============================================

/// Customer orders - main transaction entity
/// Customer info stored directly (no customer accounts in MVP)
model Order {
  id                  String        @id @default(uuid())
  /// Human-readable order number (e.g., "HM-20250126-ABC12")
  orderNumber         String        @unique @map("order_number")
  /// Customer name in Arabic - اسم الزبون
  customerName        String        @map("customer_name")
  /// Customer phone number for contact
  customerPhone       String        @map("customer_phone")
  /// Full delivery address as text - العنوان
  deliveryAddressText String        @map("delivery_address_text")
  /// Total order amount in IQD
  totalAmountIqd      Int           @map("total_amount_iqd")
  /// Payment method (COD for Iraq)
  paymentMethod       PaymentMethod @default(COD) @map("payment_method")
  /// Current order status
  status              OrderStatus   @default(PENDING)
  /// Assigned picker (staff member)
  pickerId            String?       @map("picker_id")
  /// Order notes from customer
  notes               String?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations
  picker             User?                  @relation("OrderPicker", fields: [pickerId], references: [id])
  items              OrderItem[]
  deliveryAssignment DeliveryAssignment?
  refunds            Refund[]
  reservations       InventoryReservation[]

  @@index([orderNumber])
  @@index([status], map: "idx_order_status")
  @@index([pickerId], map: "idx_order_picker_id")
  @@index([createdAt], map: "idx_order_created_at")
  @@index([customerPhone], map: "idx_order_customer_phone")
  @@map("order")
}

/// Individual items within an order
/// Captures price at time of order (immutable)
model OrderItem {
  id           String   @id @default(uuid())
  /// Parent order reference
  orderId      String   @map("order_id")
  /// Product being ordered
  productId    String   @map("product_id")
  /// Quantity ordered
  quantity     Int
  /// Unit price in IQD at time of order
  unitPriceIqd Int      @map("unit_price_iqd")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "idx_order_item_order_id")
  @@index([productId], map: "idx_order_item_product_id")
  @@map("order_item")
}

// ============================================
// DELIVERY MANAGEMENT
// ============================================

/// Delivery assignments - links orders to drivers
/// Tracks delivery lifecycle and timestamps
model DeliveryAssignment {
  id          String         @id @default(uuid())
  /// Order being delivered
  orderId     String         @unique @map("order_id")
  /// Assigned driver
  driverId    String         @map("driver_id")
  /// Delivery status
  status      DeliveryStatus @default(ASSIGNED)
  /// When driver was assigned
  assignedAt  DateTime       @default(now()) @map("assigned_at")
  /// When delivery was completed (null if not delivered)
  deliveredAt DateTime?      @map("delivered_at")
  /// Delivery notes (failure reasons, customer feedback)
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver User  @relation("DeliveryDriver", fields: [driverId], references: [id])

  @@index([orderId], map: "idx_delivery_order_id")
  @@index([driverId], map: "idx_delivery_driver_id")
  @@index([status], map: "idx_delivery_status")
  @@index([assignedAt], map: "idx_delivery_assigned_at")
  @@map("delivery_assignment")
}

// ============================================
// FINANCIAL
// ============================================

/// Order refunds for returns or cancellations
/// Tracks partial and full refunds
model Refund {
  id        String   @id @default(uuid())
  /// Order being refunded
  orderId   String   @map("order_id")
  /// Refund amount in IQD
  amountIqd Int      @map("amount_iqd")
  /// Reason for refund
  reason    String
  /// Who processed the refund
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId], map: "idx_refund_order_id")
  @@index([createdAt], map: "idx_refund_created_at")
  @@map("refund")
}

// ============================================
// AUDIT & LOGGING
// ============================================

/// Audit log for tracking all critical system mutations
/// Provides complete traceability for compliance
model AuditLog {
  id          String      @id @default(uuid())
  /// User who performed the action
  actorUserId String?     @map("actor_user_id")
  /// Type of entity affected (e.g., "Order", "Product")
  entityType  String      @map("entity_type")
  /// ID of the affected entity
  entityId    String      @map("entity_id")
  /// Action performed
  action      AuditAction
  /// Additional context (JSONB for flexibility)
  metadata    Json?       @default("{}")
  /// IP address of the request
  ipAddress   String?     @map("ip_address")
  /// User agent string
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at")

  // Relations
  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId], map: "idx_audit_actor_user_id")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([action], map: "idx_audit_action")
  @@index([createdAt], map: "idx_audit_created_at")
  @@map("audit_log")
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

/// Key-value store for system settings
/// Used for configurable parameters without code changes
model Setting {
  id        String   @id @default(uuid())
  /// Unique setting key (e.g., "delivery_fee_iqd")
  key       String   @unique
  /// Setting value (JSON for flexibility)
  value     Json
  /// Description of the setting
  description String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("setting")
}

// ============================================
// ANALYTICS & AI
// ============================================

/// Daily sales aggregations - materialized for performance
/// Computed by scheduled jobs, not real-time
model DailySalesReport {
  id             String   @id @default(uuid())
  /// Report date (day granularity)
  reportDate     DateTime @map("report_date") @db.Date
  /// Total revenue in IQD
  totalRevenue   BigInt   @map("total_revenue")
  /// Number of orders
  orderCount     Int      @map("order_count")
  /// Number of items sold
  itemCount      Int      @map("item_count")
  /// Average order value
  avgOrderValue  Int      @map("avg_order_value")
  /// Number of unique customers
  uniqueCustomers Int     @map("unique_customers")
  /// Number of refunds
  refundCount    Int      @default(0) @map("refund_count")
  /// Total refund amount
  refundAmount   BigInt   @default(0) @map("refund_amount")
  /// When this report was computed
  computedAt     DateTime @default(now()) @map("computed_at")

  @@unique([reportDate])
  @@index([reportDate], map: "idx_daily_sales_report_date")
  @@map("daily_sales_report")
}

/// Category-level daily sales for department analysis
model CategoryDailySales {
  id           String   @id @default(uuid())
  /// Report date
  reportDate   DateTime @map("report_date") @db.Date
  /// Category reference
  categoryId   String   @map("category_id")
  /// Category name (denormalized for reporting)
  categoryName String   @map("category_name")
  /// Revenue in this category
  revenue      BigInt
  /// Number of items sold
  itemCount    Int      @map("item_count")
  /// Order count containing this category
  orderCount   Int      @map("order_count")
  computedAt   DateTime @default(now()) @map("computed_at")

  @@unique([reportDate, categoryId])
  @@index([reportDate], map: "idx_category_daily_sales_date")
  @@index([categoryId], map: "idx_category_daily_sales_category")
  @@map("category_daily_sales")
}

/// Product-level analytics for demand forecasting
model ProductAnalytics {
  id                  String   @id @default(uuid())
  /// Report date
  reportDate          DateTime @map("report_date") @db.Date
  /// Product reference
  productId           String   @map("product_id")
  /// Product SKU (denormalized)
  sku                 String
  /// Product name (denormalized)
  productName         String   @map("product_name")
  /// Quantity sold
  quantitySold        Int      @map("quantity_sold")
  /// Revenue from this product
  revenue             BigInt
  /// Number of orders containing this product
  orderCount          Int      @map("order_count")
  /// Average quantity per order
  avgQuantityPerOrder Float    @map("avg_quantity_per_order")
  /// Current stock level (snapshot)
  stockLevel          Int      @map("stock_level")
  /// Days of stock remaining (computed)
  daysOfStock         Float?   @map("days_of_stock")
  computedAt          DateTime @default(now()) @map("computed_at")

  @@unique([reportDate, productId])
  @@index([reportDate], map: "idx_product_analytics_date")
  @@index([productId], map: "idx_product_analytics_product")
  @@index([sku], map: "idx_product_analytics_sku")
  @@map("product_analytics")
}

/// Demand forecast data per SKU
/// Generated by ML models or statistical methods
model DemandForecast {
  id              String   @id @default(uuid())
  /// Product reference
  productId       String   @map("product_id")
  /// SKU for easy lookup
  sku             String
  /// Forecast date (future date)
  forecastDate    DateTime @map("forecast_date") @db.Date
  /// Predicted quantity demand
  predictedQty    Float    @map("predicted_qty")
  /// Lower bound (confidence interval)
  lowerBound      Float?   @map("lower_bound")
  /// Upper bound (confidence interval)
  upperBound      Float?   @map("upper_bound")
  /// Model used (e.g., "prophet", "moving_avg", "manual")
  modelType       String   @map("model_type")
  /// Model version/training date
  modelVersion    String?  @map("model_version")
  /// Confidence level (0-1)
  confidence      Float?
  /// When forecast was generated
  generatedAt     DateTime @default(now()) @map("generated_at")

  @@unique([productId, forecastDate, modelType])
  @@index([productId], map: "idx_demand_forecast_product")
  @@index([forecastDate], map: "idx_demand_forecast_date")
  @@index([sku], map: "idx_demand_forecast_sku")
  @@map("demand_forecast")
}

/// Reorder point recommendations
/// Generated by inventory analysis
model ReorderRecommendation {
  id                String   @id @default(uuid())
  /// Product reference
  productId         String   @map("product_id")
  /// SKU for easy lookup
  sku               String
  /// Product name (denormalized)
  productName       String   @map("product_name")
  /// Current stock level
  currentStock      Int      @map("current_stock")
  /// Average daily sales (7-day)
  avgDailySales     Float    @map("avg_daily_sales")
  /// Recommended reorder point
  reorderPoint      Int      @map("reorder_point")
  /// Recommended order quantity
  reorderQuantity   Int      @map("reorder_quantity")
  /// Lead time in days (configurable)
  leadTimeDays      Int      @default(3) @map("lead_time_days")
  /// Safety stock buffer
  safetyStock       Int      @map("safety_stock")
  /// Urgency level: LOW, MEDIUM, HIGH, CRITICAL
  urgencyLevel      String   @map("urgency_level")
  /// Whether human has reviewed
  isReviewed        Boolean  @default(false) @map("is_reviewed")
  /// Who reviewed (if reviewed)
  reviewedBy        String?  @map("reviewed_by")
  /// Review timestamp
  reviewedAt        DateTime? @map("reviewed_at")
  /// Generated timestamp
  generatedAt       DateTime @default(now()) @map("generated_at")

  @@unique([productId, generatedAt])
  @@index([productId], map: "idx_reorder_rec_product")
  @@index([urgencyLevel], map: "idx_reorder_rec_urgency")
  @@index([isReviewed], map: "idx_reorder_rec_reviewed")
  @@map("reorder_recommendation")
}

/// Basket analysis - products frequently bought together
/// Used for cross-selling recommendations
model BasketAnalysis {
  id              String   @id @default(uuid())
  /// Primary product
  productIdA      String   @map("product_id_a")
  /// Associated product
  productIdB      String   @map("product_id_b")
  /// SKUs for easy lookup
  skuA            String   @map("sku_a")
  skuB            String   @map("sku_b")
  /// Number of orders containing both
  coOccurrenceCount Int    @map("co_occurrence_count")
  /// Support: P(A and B)
  support         Float
  /// Confidence: P(B|A)
  confidence      Float
  /// Lift: P(A and B) / (P(A) * P(B))
  lift            Float
  /// Analysis period start
  periodStart     DateTime @map("period_start") @db.Date
  /// Analysis period end
  periodEnd       DateTime @map("period_end") @db.Date
  computedAt      DateTime @default(now()) @map("computed_at")

  @@unique([productIdA, productIdB, periodStart])
  @@index([productIdA], map: "idx_basket_product_a")
  @@index([productIdB], map: "idx_basket_product_b")
  @@index([lift], map: "idx_basket_lift")
  @@map("basket_analysis")
}

/// Anomaly detection results
/// Flags unusual patterns for human review
model AnomalyAlert {
  id            String   @id @default(uuid())
  /// Type: REFUND_SPIKE, UNUSUAL_ORDER, STOCK_DISCREPANCY, etc.
  alertType     String   @map("alert_type")
  /// Severity: LOW, MEDIUM, HIGH
  severity      String
  /// Entity type (Order, Product, Category)
  entityType    String   @map("entity_type")
  /// Entity ID
  entityId      String?  @map("entity_id")
  /// Alert description in Arabic
  descriptionAr String   @map("description_ar")
  /// Detected value
  detectedValue Float    @map("detected_value")
  /// Expected value/range
  expectedValue Float?   @map("expected_value")
  /// Deviation percentage
  deviationPct  Float?   @map("deviation_pct")
  /// Detection method used
  detectionMethod String @map("detection_method")
  /// Whether resolved
  isResolved    Boolean  @default(false) @map("is_resolved")
  /// Who resolved
  resolvedBy    String?  @map("resolved_by")
  /// Resolution timestamp
  resolvedAt    DateTime? @map("resolved_at")
  /// Resolution notes
  resolutionNotes String? @map("resolution_notes")
  /// Detection timestamp
  detectedAt    DateTime @default(now()) @map("detected_at")

  @@index([alertType], map: "idx_anomaly_alert_type")
  @@index([severity], map: "idx_anomaly_severity")
  @@index([isResolved], map: "idx_anomaly_resolved")
  @@index([detectedAt], map: "idx_anomaly_detected_at")
  @@map("anomaly_alert")
}

/// AI/ML output audit log
/// Tracks all AI-generated recommendations for governance
model AiOutputLog {
  id             String   @id @default(uuid())
  /// Output type: FORECAST, REORDER, ANOMALY, BASKET
  outputType     String   @map("output_type")
  /// Model or algorithm used
  modelName      String   @map("model_name")
  /// Model version
  modelVersion   String?  @map("model_version")
  /// Input parameters (JSON)
  inputParams    Json?    @map("input_params")
  /// Output data (JSON)
  outputData     Json     @map("output_data")
  /// Processing duration in ms
  processingMs   Int?     @map("processing_ms")
  /// Whether output was approved by human
  isApproved     Boolean? @map("is_approved")
  /// Who approved
  approvedBy     String?  @map("approved_by")
  /// Approval timestamp
  approvedAt     DateTime? @map("approved_at")
  /// Feedback for model improvement
  feedback       String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([outputType], map: "idx_ai_output_type")
  @@index([modelName], map: "idx_ai_output_model")
  @@index([createdAt], map: "idx_ai_output_created_at")
  @@map("ai_output_log")
}

/// Scheduled job execution history
/// Tracks BullMQ job runs for monitoring
model JobExecution {
  id          String   @id @default(uuid())
  /// Job name (e.g., "daily_sales_aggregation")
  jobName     String   @map("job_name")
  /// Job status: STARTED, COMPLETED, FAILED
  status      String
  /// Start timestamp
  startedAt   DateTime @map("started_at")
  /// End timestamp
  completedAt DateTime? @map("completed_at")
  /// Duration in ms
  durationMs  Int?     @map("duration_ms")
  /// Records processed
  recordsProcessed Int? @map("records_processed")
  /// Error message if failed
  errorMessage String? @map("error_message")
  /// Error stack trace
  errorStack  String?  @map("error_stack")
  /// Additional metadata
  metadata    Json?

  @@index([jobName], map: "idx_job_execution_name")
  @@index([status], map: "idx_job_execution_status")
  @@index([startedAt], map: "idx_job_execution_started_at")
  @@map("job_execution")
}
