# ===========================================
# Hypermarket API - Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values
# NEVER commit .env files to version control

# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://hypermarket:hypermarket_dev_password@localhost:5432/hypermarket_dev?schema=public"

# Redis (Cache + Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# Meilisearch (Search)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=hypermarket_meili_master_key_dev

# S3-Compatible Storage (MinIO / Cloudflare R2)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=hypermarket
STORAGE_SECRET_KEY=hypermarket_minio_password
STORAGE_BUCKET=hypermarket
STORAGE_PUBLIC_URL=http://localhost:9000/hypermarket/public

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
